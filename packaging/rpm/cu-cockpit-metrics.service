[Unit]
Description=Collect cu-cockpit metrics and evaluate alerts
After=osmanager.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/cu-cockpit
EnvironmentFile=-/opt/cu-cockpit/os.env
ExecStart=/opt/cu-cockpit/venv/bin/python /opt/cu-cockpit/manage.py collect_system_metrics
Nice=10
