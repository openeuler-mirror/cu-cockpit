[Unit]
Description=Process one cu-cockpit scheduled backup
After=cu-cockpit.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/cu-cockpit
EnvironmentFile=/opt/cu-cockpit/os.env
ExecStart=/opt/cu-cockpit/venv/bin/python /opt/cu-cockpit/manage.py backup_center run-scheduled
TimeoutStartSec=180
KillMode=control-group
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
